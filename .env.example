# Copy this file to .env.local for local development.
# In production, set these in Vercel: Project Settings -> Environment Variables.

# Postgres connection string. In Vercel: Storage tab -> create a Postgres
# database (Neon) -> it adds this automatically. For local dev, copy the
# same value from Vercel, or point at your own Postgres instance.
DATABASE_URL=

# The single shared admin password (Part 1, admin page login). Pick
# something you and Nick can both remember and share.
ADMIN_PASSWORD=

# Random secret used to sign the admin login session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Vercel Blob storage token, used for tool photo uploads from the admin
# page. In Vercel: Storage tab -> create a Blob store -> it adds this
# automatically.
BLOB_READ_WRITE_TOKEN=

# Resend (https://resend.com) API key, used to email booking notifications.
RESEND_API_KEY=

# Where booking notification emails are sent.
NOTIFICATION_EMAIL=hello@saltandlighttoolrental.com

# Who the notification emails are sent FROM. Until you verify your own
# domain in Resend, use their shared sandbox sender below (it can only
# send to your own verified Resend account email while unverified).
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
